{
  "info": {
    "name": "GraphQL Taller API (NestJS)",
    "description": "Colección Postman para la API GraphQL (NestJS + TypeORM): usuarios, proyectos, tareas y comentarios. Usa el modo GraphQL nativo (query + variables). 'Signup' o 'Login' guardan el token en {{token}} y el resto lo reutiliza. Endpoint: {{baseUrl}} (local http://localhost:9000/graphql; use el environment de producción para Railway).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9000/graphql" },
    { "key": "token", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "commentId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (first user = superadmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.signup) {",
                  "  pm.collectionVariables.set('token', r.data.signup.token);",
                  "  pm.collectionVariables.set('userId', r.data.signup.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Signup($input: SignupInput!) {\n  signup(input: $input) {\n    token\n    user { id fullName email roles }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"fullName\": \"Super Admin\",\n    \"email\": \"admin@taller.com\",\n    \"password\": \"Admin123*\"\n  }\n}"
              }
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.login) {",
                  "  pm.collectionVariables.set('token', r.data.login.token);",
                  "  pm.collectionVariables.set('userId', r.data.login.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Login($input: LoginInput!) {\n  login(input: $input) {\n    token\n    user { id email roles }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"admin@taller.com\",\n    \"password\": \"Admin123*\"\n  }\n}"
              }
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Me {\n  me {\n    id\n    fullName\n    email\n    roles\n    isActive\n  }\n}",
                "variables": ""
              }
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Users {\n  users {\n    id\n    fullName\n    email\n    roles\n  }\n}",
                "variables": ""
              }
            }
          }
        },
        {
          "name": "Create user (superadmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.createUser) pm.collectionVariables.set('userId', r.data.createUser.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateUser($input: CreateUserInput!) {\n  createUser(input: $input) {\n    id\n    fullName\n    email\n    roles\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"fullName\": \"Regular User\",\n    \"email\": \"user1@taller.com\",\n    \"password\": \"User123*\",\n    \"roles\": [\"user\"]\n  }\n}"
              }
            }
          }
        },
        {
          "name": "Update user (superadmin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateUser($id: ID!, $input: UpdateUserInput!) {\n  updateUser(id: $id, input: $input) {\n    id\n    fullName\n    roles\n  }\n}",
                "variables": "{\n  \"id\": \"{{userId}}\",\n  \"input\": { \"fullName\": \"Updated Name\" }\n}"
              }
            }
          }
        },
        {
          "name": "Delete user (superadmin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation DeleteUser($id: ID!) {\n  deleteUser(id: $id)\n}",
                "variables": "{\n  \"id\": \"{{userId}}\"\n}"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.createProject) pm.collectionVariables.set('projectId', r.data.createProject.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateProject($input: CreateProjectInput!) {\n  createProject(input: $input) {\n    id\n    name\n    description\n    owner { email roles }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"name\": \"My Project\",\n    \"description\": \"Demo project\"\n  }\n}"
              }
            }
          }
        },
        {
          "name": "List projects (nested)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Projects {\n  projects {\n    id\n    name\n    owner { email }\n    tasks { title status }\n    comments { content }\n  }\n}",
                "variables": ""
              }
            }
          }
        },
        {
          "name": "Update project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateProject($id: ID!, $input: UpdateProjectInput!) {\n  updateProject(id: $id, input: $input) {\n    id\n    name\n    description\n  }\n}",
                "variables": "{\n  \"id\": \"{{projectId}}\",\n  \"input\": { \"name\": \"Renamed Project\" }\n}"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.createTask) pm.collectionVariables.set('taskId', r.data.createTask.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateTask($input: CreateTaskInput!) {\n  createTask(input: $input) {\n    id\n    title\n    status\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"projectId\": \"{{projectId}}\",\n    \"title\": \"Design schema\",\n    \"status\": \"TODO\"\n  }\n}"
              }
            }
          }
        },
        {
          "name": "List tasks of project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Tasks($pid: ID!) {\n  tasks(projectId: $pid) {\n    id\n    title\n    status\n    assignee { email }\n  }\n}",
                "variables": "{\n  \"pid\": \"{{projectId}}\"\n}"
              }
            }
          }
        },
        {
          "name": "Update task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateTask($id: ID!, $input: UpdateTaskInput!) {\n  updateTask(id: $id, input: $input) {\n    id\n    status\n  }\n}",
                "variables": "{\n  \"id\": \"{{taskId}}\",\n  \"input\": { \"status\": \"DONE\" }\n}"
              }
            }
          }
        },
        {
          "name": "Delete task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation DeleteTask($id: ID!) {\n  deleteTask(id: $id)\n}",
                "variables": "{\n  \"id\": \"{{taskId}}\"\n}"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.data && r.data.createComment) pm.collectionVariables.set('commentId', r.data.createComment.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateComment($input: CreateCommentInput!) {\n  createComment(input: $input) {\n    id\n    content\n    author { email }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"projectId\": \"{{projectId}}\",\n    \"content\": \"Great project!\"\n  }\n}"
              }
            }
          }
        },
        {
          "name": "List comments of project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Comments($pid: ID!) {\n  comments(projectId: $pid) {\n    id\n    content\n    author { email }\n  }\n}",
                "variables": "{\n  \"pid\": \"{{projectId}}\"\n}"
              }
            }
          }
        },
        {
          "name": "Update comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateComment($id: ID!, $input: UpdateCommentInput!) {\n  updateComment(id: $id, input: $input) {\n    id\n    content\n  }\n}",
                "variables": "{\n  \"id\": \"{{commentId}}\",\n  \"input\": { \"content\": \"Edited comment\" }\n}"
              }
            }
          }
        },
        {
          "name": "Delete comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
