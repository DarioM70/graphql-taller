# --- Server ---
PORT=4000
NODE_ENV=development

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=super_secret_change_me_in_production
JWT_EXPIRES_IN=1d

# --- Database (Prisma) ---
# SQLite by default. For cloud deploy you can point this to a Postgres URL
# and switch the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# --- Initial superadmin (used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@taller.com
SEED_ADMIN_PASSWORD=Admin123*
SEED_ADMIN_NAME=Super Admin
