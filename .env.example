# --- Server ---
# Railway/Render inject PORT automatically; locally it defaults to 9000.
PORT=9000
NODE_ENV=development

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=super_secret_change_me_in_production
JWT_EXPIRES_IN=1d

# --- Database (TypeORM / PostgreSQL) ---
# Local dev uses the Postgres from docker-compose.yml (`docker compose up -d db`).
# In production (Railway) this is provided by the managed Postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/graphql_taller
# Set to "true" only when connecting to a Postgres that requires SSL.
DATABASE_SSL=false

# --- Initial superadmin (used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@taller.com
SEED_ADMIN_PASSWORD=Admin123*
SEED_ADMIN_NAME=Super Admin
