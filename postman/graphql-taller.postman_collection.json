              "mode": "graphql",
              "graphql": {
                "query": "mutation DeleteComment($id: ID!) {\n  deleteComment(id: $id)\n}",
                "variables": "{\n  \"id\": \"{{commentId}}\"\n}"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation DeleteProject($id: ID!) {\n  deleteProject(id: $id)\n}",
                "variables": "{\n  \"id\": \"{{projectId}}\"\n}"
              }
            }
          }
        }
      ]
    }
  ]
}
